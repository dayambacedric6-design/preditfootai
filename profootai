class EloRating:
    """Elo dynamique : K adaptatif selon la différence de buts + avantage terrain."""

    BASE = 1500
    K = 20
    HOME_ADV = 65

    def __init__(self):
        self.ratings = {}
        self.historique = []

    def get(self, team: str) -> float:
        return self.ratings.get(team, self.BASE)

    @staticmethod
    def _goal_mult(goal_diff: int) -> float:
        gd = abs(goal_diff)
        if gd <= 1:
            return 1.0
        if gd == 2:
            return 1.5
        return (11 + gd) / 8.0

    def update(self, home: str, away: str, hg: int, ag: int):
        rh, ra = self.get(home), self.get(away)
        if hg > ag:
            result = 1.0
        elif hg == ag:
            result = 0.5
        else:
            result = 0.0
        expected = 1.0 / (1.0 + 10 ** ((ra - (rh + self.HOME_ADV)) / 400.0))
        k = self.K * self._goal_mult(hg - ag)
        self.ratings[home] = rh + k * (result - expected)
        self.ratings[away] = ra - k * (result - expected)

    def calculer_historique(self, df: pd.DataFrame) -> "EloRating":
        """Passe chronologique sur tout l'historique."""
        df_sorted = df.sort_values("date")
        for row in df_sorted.itertuples():
            self.update(row.home, row.away, row.home_goals, row.away_goals)
        return self


