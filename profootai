def charger_et_entrainer():
    """Charge les données selon la source et entraîne tous les modèles."""
    if onglet_source.startswith("🧪"):
        # ---- MODE DÉMO ----
        rng = np.random.default_rng(42)
        equipes = ["Paris SG", "Marseille", "Lyon", "Monaco", "Lille", "Nice",
                   "Rennes", "Lens", "Nantes", "Strasbourg", "Toulouse",
                   "Montpellier", "Brest", "Reims"]
        force = {e: rng.normal(0, 0.45) for e in equipes}
        lignes = []
        date = datetime(2023, 8, 1)
        for i in range(700):
            h, a = rng.choice(equipes, 2, replace=False)
            lam = np.exp(0.35 + force[h] - force[a] + 0.2)
            mu = np.exp(0.10 + force[a] - force[h])
            lignes.append({
                "date": (date + timedelta(days=int(i / 3))).strftime("%Y-%m-%d"),
                "home": h, "away": a,
                "home_goals": int(rng.poisson(max(lam, 0.1))),
                "away_goals": int(rng.poisson(max(mu, 0.1))),
            })
        df_hist = pd.DataFrame(lignes)
    else:
        if not api_key:
            st.info("👆 Entrez votre clé API gratuite ([football-data.org](https://www.football-data.org/client/register)) ou choisissez le mode Démo dans la barre latérale.")
            st.stop()
        df_hist = charger_historique(api_key, code_comp)
        if df_hist.empty or len(df_hist) < 100:
            st.error("❌ Données insuffisantes. Vérifiez la clé API "
                     "(le plan gratuit couvre 12 compétitions).")
            st.stop()

    # Elo
    elo = EloRating().calculer_historique(df_hist)

    # Dixon-Coles
    dc = DixonColes()
    ok_dc = dc.fit(df_hist)
    if not ok_dc:
        # Fallback Poisson simplifié (moyennes de buts)
        st.warning("⚠️ Dixon-Coles non convergé — fallback Poisson simplifié.")
        bp = df_hist.groupby("home")["home_goals"].mean().to_dict()
        ba = df_hist.groupby("away")["away_goals"].mean().to_dict()
        dc.teams = sorted(set(df_hist["home"]) | set(df_hist["away"]))
        dc.attack = {t: float(np.log(max(bp.get(t, 1.3), 0.2))) for t in dc.teams}
        dc.defense = {t: float(-np.log(max(ba.get(t, 1.3), 0.2))) for t in dc.teams}
        dc.rho, dc.home_adv, dc.fitted = -0.05, 1.25, True

    # Stats équipes + XGBoost
    stats = extraire_stats_equipes(df_hist)
    features = construire_features(df_hist, dc, elo)
    xgb_model, metriques = entrainer_xgboost(features)

    return df_hist, dc, elo, stats, xgb_model, metriques, ok_dc


