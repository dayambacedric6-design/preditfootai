def construire_features(df: pd.DataFrame, dc: DixonColes, elo: EloRating) -> pd.DataFrame:
    """
    Construit le dataset de features pour le XGBoost.
    ⚠️ Anti data-leakage : chaque feature est calculée UNIQUEMENT avec les
    matchs ANTÉRIEURS à la rencontre (via shift).
    """
    df = df.sort_values("date").reset_index(drop=True)
    df["days_ago"] = 0  # recalculé plus bas

    # Forme EMA glissante par équipe (shift(1) = on exclut le match courant)
    lignes = []
    stats = {}
    for i, row in df.iterrows():
        h, a = row["home"], row["away"]

        def get_stats(team):
            s = stats.get(team)
            if s is None:
                s = {"xgf": [], "xga": [], "pts": [], "gd": []}
                stats[team] = s
            return s

        def ema(vals, span=5):
            if not vals:
                return np.nan
            return float(pd.Series(vals).ewm(span=span, min_periods=2).mean().iloc[-1])

        sh, sa = get_stats(h), get_stats(a)

        # Buts attendus approximés par moyenne mobile exponentielle (proxy xG sans API premium)
        feat = {
            "home_form_gf": ema(sh["xgf"]),
            "home_form_ga": ema(sh["xga"]),
            "away_form_gf": ema(sa["xgf"]),
            "away_form_ga": ema(sa["xga"]),
            "home_form_pts": ema(sh["pts"]),
            "away_form_pts": ema(sa["pts"]),
            "home_elo": elo.get(h),
            "away_elo": elo.get(a),
        }
        feat["elo_diff"] = feat["home_elo"] - feat["away_elo"]
        feat["form_diff"] = (feat["home_form_pts"] or 1.0) - (feat["away_form_pts"] or 1.0)
        feat["attack_diff"] = (feat["home_form_gf"] or 1.0) - (feat["away_form_ga"] or 1.0)
        lignes.append(feat)

        # Mise à jour APRÈS avoir construit les features (anti-leakage)
        sh["xgf"].append(row["home_goals"])
        sh["xga"].append(row["away_goals"])
        sh["gd"].append(row["home_goals"] - row["away_goals"])
        sh["pts"].append(3 if row["home_goals"] > row["away_goals"]
                         else (1 if row["home_goals"] == rowaway_goals"] else 0))
        sa["xgf"].append(row["away_goals"])
        sa["xga"].append(row["home_goals"])
        sa["gd"].append(row["away_goals"] - row["home_goals"])
        sa["pts"].append(3 row["away_goals"] > row["home_goals"]
                         else (1 if row["home_goals"] == row["away_goals"] else 0))

    features = pd.DataFrame(lignes)

    # Target 1N2
    def res(row):
        if row["home_goals"] > row["away_goals"]:
            return 0
        if row["home_goals"] == row["away_goals"]:
            return 1
        return 2

    features["target"] = df.apply(res, axis=1)
    features["date"] = df["date"]
    features["home"] = df["home"]
    features["away"] = df["away"]
    return features


FEATURES_XGB = [
    "home_form_gf", "home_form_ga", "away_form_gf", "away_form_ga",
    "home_form_pts", "away_form_pts", "elo_diff", "form_diff", "attack_diff",
]


@st.cache_resource(show_spinner=False)
def entrainer_xgboost(features: pd.DataFrame):
    """
    Entraîne le XGBoost avec validation walk-forward + calibration.
    Retourne (modele_final, metriques_par_fold).
    """
    df = features.dropna(subset=FEATURES_XGB + ["target"]).reset_index(drop=True)
    if len(df) < 150:
        return None, []

    X = df[FEATURES_XGB]
    y = df["target"]

    base = XGBClassifier(
        n_estimators=400,
        max_depth=4,
        learning_rate=0.05,
        subsample=0.8,
        colsample_bytree=0.8,
        reg_lambda=2.0,
        min_child_weight=8,
        objective="multi:softprob",
        num_class=3,
        eval_metric="mlogloss",
        n_jobs=2,
        verbosity=0,
    )

    metriques = []
    tscv = TimeSeriesSplit(n_splits=4)
    for fold, (tr, te) in enumerate(tscv.split(X)):
        if len(te) < 20:
            continue
        model = CalibratedClassifierCV(base, method="isotonic", cv=3)
        model.fit(X.iloc[tr], y.iloc[tr])
        probas = model.predict_proba(X.iloc[te])
        metriques.append({
            "fold": fold + 1,
            "accuracy": float(accuracy_score(y.iloc[te], probas.argmax(axis=1))),
            "log_loss": float(log_loss(y.iloc[te], probas)),
            "n_train": int(len(tr)),
            "n_test": int(len(te)),
        })

    # Modèle final sur tout l'historique
    final = CalibratedClassifierCV(base, method="isotonic", cv=3)
    final.fit(X, y)
    return final, metriques


def features_du_match(home: str, away: str, stats: dict, elo: EloRating) -> dict:
    """Construit les features pour un match à venir (réutilise les stats du dataset)."""

    def ema(vals, span=5):
        if not vals:
            return 1.3
        return float(pd.Series(vals).ewm(span=span, min_periods=1).mean().iloc[-1])

    sh = stats.get(home, {"xgf": [1.4], "xga": [1.2], "pts": [1.4]})
    sa = stats.get(away, {"xgf": [1.2], "xga": [1.4], "pts": [1.2]})
    f = {
        "home_form_gf": ema(sh["xgf"]),
        "home_form_ga": ema(sh["xga"]),
        "away_form_gf": ema(sa["xgf"]),
        "away_form_ga": ema(sa["xga"]),
        "home_form_pts": ema(sh["pts"]),
        "away_form_pts": ema(sa["pts"]),
        "home_elo": elo.get(home),
        "away_elo": elo.get(away),
    }
    f["elo_diff"] = f["home_elo"] - f["away_elo"]
    f["form_diff"] = f["home_form_pts"] - f["away_form_pts"]
    f["attack_diff"] = f["home_form_gf"] - f["away_form_ga"]
    return f


def extraire_stats_equipes(df: pd.DataFrame) -> dict:
    """Rejoue l'historique pour obtenir les séries de stats par équipe."""
    stats = {}
    df = df.sort_values("date")
    for row in df.itertuples():
        for team in (row.home, row.away):
            if team not in stats:
                stats[team] = {"xgf": [], "xga": [], "pts": []}
        sh, sa = stats[row.home], stats[row.away]
        sh["xgf"].append(row.home_goals)
        sh["xga"].append(row.away_goals)
        sh["pts"].append(3 if row.home_goals > row.away_goals
                         else (1 if row.home_goals == row.away_goals else 0))
        sa["xgf"].append(row.away_goals)
        sa["xga"].append(row.home_goals)
        sa["pts"].append(3 if row.away_goals > row.home_goals
                         else (1 if row.home_goals == row.away_goals else 0))
    return stats


def blending(probas_dc: tuple, probas_xgb, poids_dc: float = 0.45) -> np.ndarray:
    """Combine Dixon-Coles (0.45) + XGBoost (0.55) puis renormalise."""
    if probas_xgb is None:
        return np.array(probas_dc) / sum(probas_dc)
    px = np.array(probas_xgb, dtype=float)
    pd_ = np.array(probas_dc, dtype=float)
    blend = poids_dc * pd_ + (1 - poids_dc) * px
    return blend / blend.sum()


