def backtest_value_betting(df_hist: pd.DataFrame, dc: DixonColes, elo: EloRating,
                           stats: dict, min_edge: float = 0.04,
                           marge_simulee: float = 0.06) -> pd.DataFrame:
    """
    Simule le value betting sur les 120 derniers matchs :
      - cotes simulées à partir des probas DC avec une marge bookmaker réaliste
      - on parie uniquement si edge > min_edge (Kelly 1/4, plafonné 3%)
    ⚠️ Cotes simulées = borne optimiste. Le vrai test se fait sur cotes réelles.
    """
    df_test = df_hist.sort_values("date").tail(120).reset_index(drop=True)
    bankroll = 1000.0
    historique = []
    for row in df_test.itertuples():
        pred = dc.predire(row.home, row.away)
        probas = np.array([pred["p_home"], pred["p_draw"], pred["p_away"]])

        # Cotes bookmaker simulées : probas DC inversées + marge
        p_true = probas / probas.sum()
        cotes = [1.0 / max(p * (1.0 + marge_simulee), 0.01) for p in p_true]

        analyses = analyser_value_bets(probas, cotes, min_edge)
        for idx, an in enumerate(analyses):
            if not an["value_bet"]:
                continue
            k = kelly_mise(an["proba_modele"], an["cote"])
            if k["stake"] <= 0:
                continue
            # Résultat réel
            issue_reelle = 0 if row.home_goals > row.away_goals else (
                1 if row.home_goals == row.away_goals else 2)
            gagne = (idx == issue_reelle)
            pnl = k["stake"] * (an["cote"] - 1) if gagne else -k["stake"]
            bankroll += pnl
            historique.append({
                "date": row.date,
                "match": f"{row.home} - {row.away}",
                "pari": an["pari"],
                "cote": round(an["cote"], 2),
                "mise": round(k["stake"], 2),
                "gagne": gagne,
                "pnl": round(pnl, 2),
                "bankroll": round(bankroll, 2),
            })
    return pd.DataFrame(historique)


