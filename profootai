class DixonColes:
    """
    Modèle Dixon-Coles :
      - forces attaque / défense par équipe
      - paramètre rho : corrige la sous-estimation des bas scores (0-0, 1-0, 0-1, 1-1)
      - décroissance temporelle exponentielle (xi)
    """

    XI = 0.0065  # demi-vie d'environ 106 jours

    def __init__(self):
        self.attack = {}
        self.defense = {}
        self.rho = -0.05
        self.home_adv = 1.25
        self.teams = []
        self.fitted = False

    @staticmethod
    def _tau(x: int, y: int, lam: float, mu: float, rho: float) -> float:
        if x == 0 and y == 0:
            return 1.0 - lam * mu * rho
        if x == 0 and y == 1:
            return 1.0 + lam * rho
        if x == 1 and y == 0:
            return 1.0 + mu * rho
        if x == 1 and y == 1:
            return 1.0 - rho
        return 1.0

    def fit(self, df: pd.DataFrame) -> bool:
        df = df.copy()
        df["date"] = pd.to_datetime(df["date"])
        jour_max = df["date"].max()
        df["days_ago"] = (jour_max - df["date"]).dt.days
        df = df[df["days_ago"] < 400]  # fenêtre glissante de 400 jours

        self.teams = sorted(set(df["home"]) | set(df["away"]))
        idx = {t: i for i, t in enumerate(self.teams)}
        n = len(self.teams)
        if n < 4 or len(df) < 60:
            return False

        avg = float(df["home_goals"].mean())

        def neg_ll(params):
            att = params[:n]
            deff = params[n:2 * n]
            rho = params[-2]
            home_adv = params[-1]
            ll = 0.0
            for row in df.itertuples():
                i = idx[row.home]
                j = idx[row.away]
                lam = np.exp(att[i] + deff[j] + np.log(home_adv))
                mu = np.exp(att[j] + deff[i])
                w = np.exp(-self.XI * row.days_ago)
                p = (poisson.pmf(row.home_goals, lam)
                     * poisson.pmf(row.away_goals, mu)
                     * self._tau(row.home_goals, row.away_goals, lam, mu, rho))
                ll -= w * np.log(max(p, 1e-10))
            return ll

        x0 = np.concatenate([
            np.full(n, np.log(max(avg, 0.5))),
            np.full(n, -np.log(max(avg, 0.5))),
            [-0.05],
            [1.25],
        ])
        bounds = [(-3.0, 3.0)] * (2 * n) + [(-0.2, 0.2), (1.0, 1.8)]

        try:
            res = minimize(neg_ll, x0, method="L-BFGS-B", bounds=bounds)
            if not res.success or not np.all(np.isfinite(res.x)):
                return False
            p = res.x
            self.attack = {t: float(p[i]) for t, i in idx.items()}
            self.defense = {t: float(p[n + i]) for t, i in idx.items()}
            self.rho = float(p[-2])
            self.home_adv = float(p[-1])
            self.fitted = True
            return True
        except Exception:
            return False

    def lambdas(self, home: str, away: str):
        lam = np.exp(
            self.attack.get(home, 0.0)
            + self.defense.get(away, 0.0)
            + np.log(self.home_adv)
        )
        mu = np.exp(
            self.attack.get(away, 0.0)
            + self.defense.get(home, 0.0)
        )
        return lam, mu

    def matrice_scores(self, home: str, away: str) -> np.ndarray:
        lam, mu = self.lambdas(home, away)
        M = np.zeros((MAX_GOALS + 1, MAX_GOALS + 1))
        for x in range(MAX_GOALS + 1):
            for y in range(MAX_GOALS + 1):
                M[x, y] = (poisson.pmf(x, lam)
                           * poisson.pmf(y, mu)
                           * self._tau(x, y, lam, mu, self.rho))
        s = M.sum()
        if s <= 0:
            M[:] = 1.0
            s = M.sum()
        return M / s

    def extraire_marches(self, M: np.ndarray) -> dict:
        p_home = float(np.tril(M, -1).sum())
        p_draw = float(np.trace(M))
        p_away = float(np.triu(M, 1).sum())
        total = sum(p_over for p_over in [] )  # placeholder removed below
        pairs = [(x, y) for x in range(MAX_GOALS + 1) for y in range(MAX_GOALS + 1)]
        p_over = sum(M[x, y] for (x, y) in pairs if x + y > 2)
        p_btts = sum(M[x, y] for (x, y) in pairs if x >= 1 and y >= 1)
        top = sorted(((x, y, M[x, y]) for (x, y) in pairs), key=lambda t: -t[2])[:3]
        return {
            "p_home": p_home,
            "p_draw": p_draw,
            "p_away": p_away,
            "p_over25": float(p_over),
            "p_btts": float(p_btts),
            "top_scores": [(f"{x}-{y}", float(p)) for x, y, p in top],
        }

    def predire(self, home: str, away: str) -> dict:
        M = self.matrice_scores(home, away)
        result = self.extraire_marches(M)
        lam, mu = self.lambdas(home, away)
        result["lam"] = float(lam)
        result["mu"] = float(mu)
        return result


